# Backend Environment Variables

# Node environment
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret key (use a strong random string in production)
JWT_SECRET=change_this_to_a_secure_random_string

# Server port
PORT=3001

# Allowed CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,https://atlasderslik.com

# Frontend URL (used for payment callbacks)
FRONTEND_URL=http://localhost:3000

# ─── Iyzico Payment Gateway ───────────────────────────────
# Required only if payment features are enabled.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Groq AI (get from https://console.groq.com/keys) — server-side only
GROQ_API_KEY=

# Hugging Face (https://huggingface.co/settings/tokens) — AI fallback, server-side only
HUGGINGFACE_API_KEY=

# AtlasAI premium provider — API server only; never NEXT_PUBLIC_
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Educational image generation, invoked explicitly in AtlasAI's image mode.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
ATLAS_IMAGE_GENERATION_ENABLED=true
# Optional overrides for text-only fallback providers
GROQ_MODEL=llama-3.3-70b-versatile
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Trusted reverse-proxy hops: 1 behind Render, 0 for a directly exposed API.
TRUST_PROXY_HOPS=1

# Optional one-time import tools only. Never set a shared default in source code.
# Keep the private JSON outside git; .private-seed/ is ignored.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_USERS_FILE=
