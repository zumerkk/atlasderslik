# Backend Environment Variables

# Node environment
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret key (use a strong random string in production)
JWT_SECRET=change_this_to_a_secure_random_string

# Server port
PORT=3001

# Allowed CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,https://atlasderslik.com

# Frontend URL (used for payment callbacks)
FRONTEND_URL=http://localhost:3000

# ─── Iyzico Payment Gateway ───────────────────────────────
# Required only if payment features are enabled.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Groq AI (get from https://console.groq.com/keys) — server-side only
GROQ_API_KEY=

# Hugging Face (https://huggingface.co/settings/tokens) — AI fallback, server-side only
HUGGINGFACE_API_KEY=

# AtlasAI premium provider — API server only; never NEXT_PUBLIC_
OPENAI_API_KEY=
# Production only: explicitly true after the provider and curriculum are verified.
ATLAS_OPENAI_ENABLED=false
OPENAI_MODEL=gpt-6-luna
# Application-wide 30-day trial. Set a lower amount or 0 to pause. Max $50.
ATLAS_OPENAI_BUDGET_USD=50
# Educational image generation, invoked explicitly in AtlasAI's image mode.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
ATLAS_IMAGE_GENERATION_ENABLED=true
# Recorded lessons: audio transcription + sampled board/slide frames.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
ATLAS_VIDEO_STORAGE_DIR=.atlas-media/videos
# Required in production for uploads; must be the real mounted volume.
ATLAS_VIDEO_STORAGE_MOUNT=
ATLAS_VIDEO_MAX_UPLOAD_MB=256
ATLAS_VIDEO_MAX_MINUTES=60
ATLAS_VIDEO_MAX_FRAMES=12
ATLAS_VIDEO_DAILY_SUMMARIES=6
ATLAS_VIDEO_STORAGE_MAX_GB=8
# Optional absolute paths instead of the packaged platform binaries.
FFMPEG_PATH=
FFPROBE_PATH=
# Public HTTPS API address, required for iyzico sandbox and live callbacks.
PAYMENT_CALLBACK_URL=
# Production only: explicitly true after merchant approval and sandbox validation.
PAYMENT_CHECKOUT_ENABLED=false
# Public seller identity; must match the merchant account. Never enter API keys here.
MERCHANT_TITLE=
MERCHANT_TAX_NUMBER=
MERCHANT_TAX_OFFICE=
MERCHANT_ADDRESS=
MERCHANT_EMAIL=
MERCHANT_PHONE=
PAYMENT_TERMS_VERSION=terms-v2026-10-30
MEMBERSHIP_TERMS_VERSION=terms-v2026-10-30
PRIVACY_POLICY_VERSION=privacy-v2026-10-30
SALES_AGREEMENT_VERSION=sales-v2026-10-30
PRE_INFORMATION_VERSION=preinfo-v2026-10-30
# Optional overrides for text-only fallback providers
GROQ_MODEL=llama-3.3-70b-versatile
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Trusted reverse-proxy hops: 1 behind Render, 0 for a directly exposed API.
TRUST_PROXY_HOPS=1

# Optional one-time import tools only. Never set a shared default in source code.
# Keep the private JSON outside git; .private-seed/ is ignored.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_USERS_FILE=
